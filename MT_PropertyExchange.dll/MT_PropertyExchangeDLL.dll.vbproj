  <!-- The interop assembly for the native dsofile COM component is generated
       from the checked-in type library on first build. It must be signed with
       the dsofile key because this assembly is strong-named. -->
  <Target Name="GenerateDsofileInterop" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(MSBuildProjectDirectory)\..\lib\Interop.Dsofile.dll')">
    <Error Condition="'$(TargetFrameworkSDKToolsDirectory)' == ''" Text="tlbimp.exe not found (TargetFrameworkSDKToolsDirectory is empty). Generate ..\lib\Interop.Dsofile.dll manually from a VS Developer Command Prompt: tlbimp Dsofile\Lib\dsofile.tlb /keyfile:Dsofile\dsofile_key.snk /namespace:dsofile /out:lib\Interop.Dsofile.dll" />
    <MakeDir Directories="$(MSBuildProjectDirectory)\..\lib" />
    <Exec Command="&quot;$(TargetFrameworkSDKToolsDirectory)tlbimp.exe&quot; /nologo &quot;$(MSBuildProjectDirectory)\..\Dsofile\Lib\dsofile.tlb&quot; /keyfile:&quot;$(MSBuildProjectDirectory)\..\Dsofile\dsofile_key.snk&quot; /namespace:dsofile /out:&quot;$(MSBuildProjectDirectory)\..\lib\Interop.Dsofile.dll&quot;" />
  </Target>
