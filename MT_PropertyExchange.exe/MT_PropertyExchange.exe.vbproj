  <!-- To modify your build process, add your task inside one of the targets below and uncomment it. 
       Other similar extension points exist, see Microsoft.Common.targets.
  <Target Name="BeforeBuild">
  </Target>
  <Target Name="AfterBuild">
  </Target>
  -->
  <PropertyGroup>
    <PostBuildEvent>@echo off

if "$(ConfigurationName)"=="Debug" goto :EOF

del /q "$(TargetDir)\*.pdb" &gt;nul 2&gt;nul
rem del /q "$(TargetDir)\*.config" &gt;nul 2&gt;nul
del /q "$(TargetDir)\build.*" &gt;nul 2&gt;nul

set LOGFILE= "$(TargetDir)\build.log"

for /f "tokens=1-3 delims=.-/ " %25%25a in ('date /t') do ( set day=%25%25a&amp;set month=%25%25b&amp;set year=%25%25c&amp;set datestamp=%25%25c-%25%25b-%25%25a)

for /f "tokens=5-8 delims=:., " %25%25a in ('echo/^|time') do ( set hh=%25%25a&amp;set nn=%25%25b&amp;set ss=%25%25c&amp;set cs=%25%25d)
echo $(TargetName) ($(PlatformName)) %25datestamp%25 %25hh%25:%25nn%25:%25ss%25 &gt; %25LOGFILE%25
SET Timestamp=%25hh%25-%25nn%25-%25ss%25

copy /Y /V "$(SolutionDir)\lib\$(PlatformName)\*.*" "$(TargetDir)"
sleep 1


rem --------------------------------------------------------------------
xcopy /K /Y "$(TargetDir)*.*" "$(SolutionDir)\MTPropertyExchangeInstall\$(PlatformName)\" &gt;nul 2&gt;nul
REM xcopy /K /Y "$(TargetDir)*.*" "D:\TestRT\$(PlatformName)\" &gt;nul 2&gt;nul

rem --------------------------------------------------------------------
pushd "$(SolutionDir)"
if exist Install\MTPropertyExchangeInstall.exe del Install\MTPropertyExchangeInstall.exe
mkdir MTPropertyExchangeInstall\lib &gt;nul 2&gt;nul
copy /Y /V "$(SolutionDir)\lib\install\*.*" MTPropertyExchangeInstall\lib
7-zip\7z.exe a -mx=9 MTPropertyExchangeInstall.7z MTPropertyExchangeInstall\

mkdir Install &gt;nul 2&gt;nul
copy /b 7-zip\7zsd_LZMA.sfx + 7-zip\MTPE_sxf_config.txt + MTPropertyExchangeInstall.7z Install\MTPropertyExchangeInstall-%25datestamp%25-%25Timestamp%25.exe

del MTPropertyExchangeInstall.7z
popd

pushd \\cadlnz.primetals.com\apps600\TCApp_ww300\Tools\MTPropertyExchange

echo Archiving old version ...
move /Y *.exe Archive\ 2&gt;nul
move /Y *.zip Archive\ 2&gt;nul
echo Copying to  \\cadlnz.primetals.com\apps600\TCApp_ww300\Tools\MTPropertyExchange ...
copy "$(SolutionDir)\Install\MTPropertyExchangeInstall-%25datestamp%25-%25Timestamp%25.exe" .
popd


:ende</PostBuildEvent>
    <PreBuildEvent>if "$(ConfigurationName)"=="Debug" goto :EOF

REM del /q  "$(SolutionDir)\MTPropertyExchangeInstall\$(PlatformName)\*.*" &gt;nul 2&gt;nul
REM del /q  "D:\TestRT\$(PlatformName)\*.*" &gt;nul 2&gt;nul

:ende</PreBuildEvent>
