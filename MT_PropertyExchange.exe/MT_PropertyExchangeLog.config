<?xml version="1.0" encoding="utf-8"?>
<!--This is the root of your config file-->
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net"/>
  </configSections>
  <log4net>
    <appender name="PropertyExchangeLog" type="log4net.Appender.RollingFileAppender">
      <file value="${TMP}\PropertyExchange.log" />
      <appendToFile value="true" />
      <rollingStyle value="Size" />
      <maxSizeRollBackups value="5" />
      <maximumFileSize value="10MB" />
      <staticLogFileName value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date{yyyy-MM-dd HH:mm:ss,fff} %-5level %logger.%method - %message%newline" />
      </layout>
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    </appender>
    <root>
      <level value="WARN"/>
      <appender-ref ref="PropertyExchangeLog"/>
    </root>
  </log4net>
</configuration>
